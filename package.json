{
  "name": "my-blog-frontend",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently --kill-others \"next dev\" \"wait-on http://127.0.0.1:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "next build && electron-builder --win",
    "electron:start": "next build && electron ."
  },
  "dependencies": {
    "@uiw/react-md-editor": "^4.0.11",
    "dompurify": "^3.4.11",
    "isomorphic-dompurify": "^3.18.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.myblog.desktop",
    "productName": "My Blog",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "next.config.mjs",
      "postcss.config.mjs",
      "tailwind.config.js",
      "jsconfig.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "app",
        "filter": [
          ".next/**/*",
          "public/**/*",
          "node_modules/**/*",
          "package.json",
          "next.config.mjs"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
